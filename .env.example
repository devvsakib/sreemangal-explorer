# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Optional Supabase PostgreSQL database URL
# e.g., https://xyzcompany.supabase.co
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public anonymous key for client requests with RLS
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Protected server-only key for privileged operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# REGIONAL_DISPATCH_PHONE: Local coordination desk phone in Sreemangal
VITE_SUPPORT_PHONE="01712004488"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=""

